# Telegram MVP
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Local Chroma persistence
CHROMA_PERSIST_DIR=./data/chroma

# Remote GPU endpoints
REMOTE_LLM_URL=http://your-remote-host:11434
REMOTE_EMBEDDINGS_URL=http://your-remote-host:11434

# Remote auth (example values only)
REMOTE_AUTH_USER=example_user
REMOTE_AUTH_PASSWORD=example_password

# Optional tuning
RETRIEVAL_K=4

# Keep existing class orchestration from llm_implementation/config
LLM_IMPLEMENTATION_CONFIG=python/webAPI/app/utils/config.json
REMOTE_LLM_MODEL=llama3.1
